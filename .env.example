# ID du Google Sheet (dans l'URL : .../spreadsheets/d/CECI_EST_L_ID/edit)
SPREADSHEET_ID=ton_spreadsheet_id_ici

# Nom de l'onglet dans ton Google Sheet (ex: Feuille1, Contacts, etc.)
SHEET_NAME=Feuille1

# Contenu JSON complet du fichier de clé de compte de service Google
# Colle tout le contenu JSON sur UNE SEULE LIGNE entre les guillemets
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
